# ---- Prototype mode: works with no provider keys ----
MOCK_AI=1

# ---- Auth (scripts/init-env.sh generates these for you) ----
AUTH_SECRET=
EDGE_API_KEY=
# Demo accounts admin|engineer|approver|viewer@cawrys.local are created for the demo tenant.
SEED_DEMO=1
DEMO_PASSWORD=cawrys-demo
# 1 lets anyone create a new tenant at /v1/auth/signup. Keep 0 unless you want self-service signup.
ALLOW_SIGNUP=0
# Set to 1 when the web app is served over HTTPS
COOKIE_SECURE=0

# ---- Database ----
# Leave blank to use local embedded SQLite fallback. For Neon, paste your connection string:
# NEON_DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/cawrys?sslmode=require
NEON_DATABASE_URL=
# SQLITE_PATH=/tmp/cawrys.db

# ---- Real AI (set MOCK_AI=0) ----
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-cawrys-change-me
# Customer provider keys (used only by the LiteLLM proxy)
GEMINI_API_KEY=
UPSTREAM_REASON_MODEL=gemini/gemini-4-argon
UPSTREAM_EXTRACT_MODEL=gemini/gemini-3.8-flash
UPSTREAM_VISION_MODEL=gemini/gemini-3.8-flash

# ---- Cloudflare R2 (blank = files saved to a local volume) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cawrys-files

# Models (LiteLLM aliases from infra/litellm/config.yaml)
MODEL_EXTRACT=cawrys-extract
MODEL_VISION=cawrys-vision
MODEL_REASON=cawrys-reason
